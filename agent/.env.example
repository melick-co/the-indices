SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-key
# ElevenLabs: hero images, hero video, voiceover and the reel tool. Server only; never
# prefix with NEXT_PUBLIC_. Needs a Pro plan or above and a key with the Image & Video
# (or Flows) permission. Set in GitHub Actions secrets and on Vercel (Production + Preview).
# Create a key at https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=...
# Optional: a fixed narration voice; otherwise a premade voice is chosen (Australian preferred).
# ELEVENLABS_VOICE_ID=...
# X (Twitter) trends — OAuth 1.0a user context for v1.1 trends/place
# TWITTER_API_KEY=your-api-key
# TWITTER_API_SECRET=your-api-secret
# TWITTER_ACCESS_TOKEN=your-access-token
# TWITTER_ACCESS_TOKEN_SECRET=your-access-token-secret
# NOTIFY_WEBHOOK=https://hooks.slack.com/...  # optional
# INBOUND_EMAIL_SECRET=...                    # optional; bearer for /api/inbox/email
