{
  "index_id": "hsi",
  "name": "Household Squeeze Index",
  "concept": "Financial pressure on the household balance sheet",
  "vintage": "2026.1",
  "custom_weights": false,
  "components": [
    {
      "metric_id": "household_debt_to_income",
      "label": "Household debt to income",
      "bounds": [0, 250],
      "weight": 1
    },
    {
      "metric_id": "years_to_buy_home",
      "label": "Years of net income to buy a home",
      "bounds": [0, 25],
      "weight": 1
    },
    {
      "metric_id": "real_wage_growth_2010_2024",
      "label": "Real wage growth 2010-2024",
      "bounds": [-25, 80],
      "weight": 1
    },
    {
      "metric_id": "household_savings_rate",
      "label": "Household savings rate",
      "bounds": [-5, 20],
      "weight": 1
    }
  ]
}
